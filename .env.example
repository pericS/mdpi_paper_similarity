# Local development only. Copy to .env, which Git ignores: cp .env.example .env

# Used by compose.yaml when the database is created for the first time.
# The same password must appear in PAPER_SIMILARITY_DATABASE_URL below.
POSTGRES_PASSWORD=local-dev-only

# Required. The URL must use the psycopg 3 driver: postgresql+psycopg://
PAPER_SIMILARITY_DATABASE_URL=postgresql+psycopg://paper_similarity:local-dev-only@127.0.0.1:5432/paper_similarity

# Optional: DEBUG, INFO, WARNING, ERROR or CRITICAL
PAPER_SIMILARITY_LOG_LEVEL=INFO
