# Local development only. Copy to .env, which Git ignores: cp .env.example .env

# Used by compose.yaml when the database is created for the first time.
# Put special characters in single quotes: 'p@ss$word'. Later changes do not change
# the password of an existing database.
POSTGRES_PASSWORD=local-dev-only

# Required outside containers. The URL must use the psycopg 3 driver: postgresql+psycopg://
# It contains the same password, with special characters URL-encoded, e.g. @ as %40.
PAPER_SIMILARITY_DATABASE_URL=postgresql+psycopg://paper_similarity:local-dev-only@127.0.0.1:5432/paper_similarity

# Optional: DEBUG, INFO, WARNING, ERROR or CRITICAL
PAPER_SIMILARITY_LOG_LEVEL=INFO

# Optional: where the embedding model (about 70 MB) is stored after the first download
PAPER_SIMILARITY_EMBEDDING_CACHE_DIR=~/.cache/paper-similarity

# Optional: longest text that is embedded; longer submissions are rejected
PAPER_SIMILARITY_MAX_TEXT_TOKENS=20000
